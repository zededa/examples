name: "EfficientNet-B3"
backend: "onnxruntime"
max_batch_size: 32
version_policy: { latest: { num_versions: 1 } }

input [
  {
    name: "images"
    data_type: TYPE_FP32
    format: FORMAT_NCHW
    dims: [3, 224, 224]
  }
]

output [
  {
    name: "predictions"
    data_type: TYPE_FP32
    dims: [196]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [0]
  },
  {
    kind: KIND_CPU
    count: 1
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 100
  preferred_batch_size: [1, 2, 4, 8]
}

optimization {
  execution_accelerators {
    gpu_execution_accelerator : [ {
      name : "tensorrt"
    } ]
  }
}

model_warmup [
  {
    name: "warmup_batch_1"
    batch_size: 1
    inputs: {
      key: "images"
      value: {
        data_type: TYPE_FP32
        dims: [3, 224, 224]
        zero_data: true
      }
    }
  }
]
